{
  "Urls": "http://+:5100",
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "user-service",
        "Match": { "Path": "/api/Users/{**catch-all}" }
      },
      "vehicles-route": {
        "ClusterId": "vehicle-service",
        "Match": { "Path": "/api/Vehicles/{**catch-all}" }
      },
      "garages-route": {
        "ClusterId": "garage-service",
        "Match": { "Path": "/api/Garages/{**catch-all}" }
      },
      "services-route": {
        "ClusterId": "garage-service",
        "Match": { "Path": "/api/Services/{**catch-all}" }
      },
      "service-histories-route": {
        "ClusterId": "service-history-service",
        "Match": { "Path": "/api/ServiceHistories/{**catch-all}" }
      },
      "chatbot-conversations-route": {
        "ClusterId": "chatbot-service",
        "Match": { "Path": "/api/ChatbotConversations/{**catch-all}" }
      },
      "chatbot-messages-route": {
        "ClusterId": "chatbot-service",
        "Match": { "Path": "/api/ChatbotMessages/{**catch-all}" }
      },
      "ai-image-analyses-route": {
        "ClusterId": "chatbot-service",
        "Match": { "Path": "/api/AiImageAnalyses/{**catch-all}" }
      },
      "chatbot-knowledge-bases-route": {
        "ClusterId": "chatbot-service",
        "Match": { "Path": "/api/ChatbotKnowledgeBases/{**catch-all}" }
      },
      "ai-usage-logs-route": {
        "ClusterId": "chatbot-service",
        "Match": { "Path": "/api/AiUsageLogs/{**catch-all}" }
      },
      "vehicle-issues-route": {
        "ClusterId": "diagnostics-service",
        "Match": { "Path": "/api/VehicleIssues/{**catch-all}" }
      },
      "diagnostic-rules-route": {
        "ClusterId": "diagnostics-service",
        "Match": { "Path": "/api/DiagnosticRules/{**catch-all}" }
      },
      "image-diagnostics-route": {
        "ClusterId": "diagnostics-service",
        "Match": { "Path": "/api/ImageDiagnostics/{**catch-all}" }
      },
      "audit-logs-route": {
        "ClusterId": "logging-service",
        "Match": { "Path": "/api/AuditLogs/{**catch-all}" }
      },
      "error-logs-route": {
        "ClusterId": "logging-service",
        "Match": { "Path": "/api/ErrorLogs/{**catch-all}" }
      },
      "activity-logs-route": {
        "ClusterId": "logging-service",
        "Match": { "Path": "/api/ActivityLogs/{**catch-all}" }
      },
      "request-response-logs-route": {
        "ClusterId": "logging-service",
        "Match": { "Path": "/api/RequestResponseLogs/{**catch-all}" }
      },
      "error-messages-route": {
        "ClusterId": "logging-service",
        "Match": { "Path": "/api/ErrorMessages/{**catch-all}" }
      }
    },
    "Clusters": {
      "user-service": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5101" }
        }
      },
      "vehicle-service": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5102" }
        }
      },
      "garage-service": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5103" }
        }
      },
      "service-history-service": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5104" }
        }
      },
      "chatbot-service": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5105" }
        }
      },
      "diagnostics-service": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5106" }
        }
      },
      "logging-service": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5107" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
